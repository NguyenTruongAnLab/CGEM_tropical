@article{SukkueaArsanchai2025,
  title = {{{AI-driven}} Time Series Forecasting of Coastal Water Quality Using Sentinel-2 Imagery: A Case Study in the Gulf of {{Thailand}}},
  shorttitle = {{{AI-driven}} Time Series Forecasting of Coastal Water Quality Using Sentinel-2 Imagery},
  author = {Sukkuea, Arsanchai and Akkajit, Pensiri and Suwannarat, Korakot and Foithong, Punnawit and Afsarimanesh, Nasrin and Alahi, Md Eshrat E.},
  date = {2025-06-16},
  journaltitle = {Water},
  shortjournal = {Water},
  volume = {17},
