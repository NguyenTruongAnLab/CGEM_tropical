  shorttitle = {Transformation of Rural Landscapes in the {{Vietnamese Mekong Delta}} from 1990 to 2019},
  author = {Nguyen, Ho and Trung, Ta Hoang and Phan, Duong Cao and Anh Tran, Thong and Thi Hai Ly, Nguyen and Nasahara, Kenlo Nishida and Prishchepov, Alexander V. and Hölzel, Norbert},
