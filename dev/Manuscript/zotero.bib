@book{VolkovAlexei2018,
  title = {On Two Maps of Vietnam by Alexandre de Rhodes},
  author = {Volkov, Alexei},
  date = {2018-08-01},
  pages = {117},
  doi = {10.1142/9789813233256_0005},
  abstract = {The shape and location of Vietnam in the Western maps made prior to the late seventeenth century changed considerably; one can suggest that the data collected by Jesuit missionaries working in Vietnam since 1615 played a certain role in this process. In my paper, I will focus on two maps of Vietnam published by the Jesuit Alexandre de Rhodes (1593-1660) in his Relazione de’ felici successi della Santa Fede predicate da’ padri della Compagnia di Giesu nel Regno di Tunchino (Rome, 1650) and Divers voyages et missions du P. Alexandre de Rhodes en la Chine et autres royaumes de l’Orient (Paris, 1653) and try to identify the sources he may have used when producing his maps. The authorship of the maps is obscure; a legend on the latter map states that it was compiled by “Jesuit Fathers”, but it remains unclear whether the mentioned “Fathers” worked in Vietnam or in Europe, or both. The Prime Meridian used in this map is arguably identical with that used earlier in some European maps, in particular, in the map of J. Hondius of 1606; this suggests that a version of the latter map may have been available to the missionaries working in Vietnam who improved it by adding a number of toponyms and elements of relief. © 2018 by World Scientific Publishing Co. Pte. Ltd. All rights reserved.},
  pagetotal = {99},
