@article{CarvalhoWesleydosSantos2024,
  title = {Influence of Land Use and Land Cover on the Quality of Surface Waters and Natural Wetlands in the Miranda River Watershed, Brazilian Pantanal},
  author = {Carvalho, Wesley dos Santos and Filho, Fernando Jorge Corrêa Magalhães and Rodrigues, Lucia Ribeiro and Calheiros, Cristina Sousa Coutinho},
  date = {2024-01},
  journaltitle = {Applied Sciences},
  shortjournal = {Appl. Sci.},
  volume = {14},
