@article{MatsubaraHiroki2009,
  title = {Long-Term Declining Trends in River Water Ph in Central {{Japan}}},
  author = {Matsubara, Hiroki and Morimoto, Shingo and Sase, Hiroyuki and Ohizumi, Tsuyoshi and Sumida, Hiroshi and Nakata, Makoto and Ueda, Hiromasa},
