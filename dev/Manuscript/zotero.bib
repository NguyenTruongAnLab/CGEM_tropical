@article{HuangChangchun2017,
  title = {Spatiotemporal Variation in Particulate Organic Carbon Based on Long-Term {{MODIS}} Observations in Taihu Lake, China},
  author = {Huang, Changchun and Jiang, Quanliang and Yao, Ling and Li, Yunmei and Yang, Hao and Huang, Tao and Zhang, Mingli},
  date = {2017-06-17},
  journaltitle = {Remote Sensing},
