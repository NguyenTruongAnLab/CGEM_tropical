@article{BadylakSusan2016,
  title = {Phytoplankton Dynamics in a Subtropical Tidal Creek: Influences of Rainfall and Water Residence Time on Composition and Biomass},
  shorttitle = {Phytoplankton Dynamics in a Subtropical Tidal Creek},
  author = {Badylak, Susan and Phlips, Edward and Dix, Nicole and Hart, Jane and Srifa, Akeapot and Haunert, Daniel and He, Zenli and Lockwood, Jean and Stofella, Peter and Sun, Detong and Yang, Yaugen},
  date = {2016-03-24},
  journaltitle = {Marine and Freshwater Research},
  volume = {67},
  number = {4},
  pages = {466--482},
  issn = {1323-1650, 1448-6059},
  doi = {10.1071/MF14325},
  url = {https://connectsci.au/mf/article/67/4/466/59797/Phytoplankton-dynamics-in-a-subtropical-tidal},
  urldate = {2026-02-04},
  abstract = {Concerns about global climate change have heightened awareness of the role changing rainfall regimes play in altering plankton communities of coastal ecosystems. In this study spatial and temporal patterns of phytoplankton composition and biomass in a sub-tropical tidal creek in Florida were observed over three wet and dry seasons, which included the major storm year of 2005 and the drought year of 2006. Shifts in rainfall levels were associated with changes in phytoplankton composition and biomass, but the effects varied between the upper and lower reaches of the creek. The upper reach of the creek was fresh throughout the study period. The oligohaline to mesohaline lower creek alternated between fresh and marine species in response to shifts in salinity regimes. Blooms of the freshwater dinoflagellate Peridinium sp., small centric diatoms and nitrogen-fixing cyanobacteria were common in the upper Ten Mile Creek during low rainfall years. The euryhaline marine dinoflagellate Akashiwo sanguinea and centric diatoms (e.g. Leptocylindrus minimus) were observed at bloom levels in the lower creek during low to average rainfall periods. The results are discussed within the context of how variability in rainfall influence water residence times, nutrient concentrations and salinity regimes, which in turn influence phytoplankton composition and biomass.},
  langid = {english},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Modelling\New\Badylak et al. - 2016 - Phytoplankton dynamics in a subtropical tidal creek influences of rainfall and water residence time.pdf}
}

@book{BairdDan2011,
  title = {Estuarine and {{Coastal Ecosystem Modelling}}. {{Volume}} 9 in the "{{Treatise}} on {{Estuarine}} and {{Coastal Science}}".},
  author = {Baird, Dan and Metha, and},
  date = {2011-12-01},
  abstract = {9.1. Estuarine and Coastal Ecosystem Modelling: A Synthesis. Dan Baird1 and Ashish Mehta2 1Dan Baird, Department of Botany and Zoology, University of Stellenbosch, Stellenbosch, South Africa. danbaird@sun.ac.za 2Ashish Mehta, Department of Civil and Coastal Engineering, University of Florida, Gainesville, FL 32611, USA. mehta@coastal.ufl.edu 9.1.1 GENERAL SYSTHESIS In this Volume 9 of the “Treatise on Estuarine and Coastal Science” the focus is on the theory of ecosystem modelling, the application of these theoretical formulations to living ecosystems, and the use and application of modelling protocols in modern ecosystem research and management. Most of the chapters in this volume contribute to assessments of the functioning of coastal ecosystems by means of examples of systems and process models. The objectives of the chapter can be summarized as follows: • To provide an in-depth overview of the philosophy, mathematical foundation, and of the ecosystem modelling protocols in modern ecological research; • To illustrate the application of these mathematical and modelling frameworks to coastal ecosystems by means of a large number of examples from all over the world; • To explore novel approaches to the modelling of coastal ecosystems; • To examine the linkages between physical, chemical, and biological processes in estuarine and coastal ecosystems, and • To assess the management applications of modelling to estuarine and coastal ecosystems. The coastal zone have been defined elsewhere in the treatise (see Volume 1), but it is nevertheless important to note the extraordinary role of the coastal zone and its constituent ecosystems in the global context of human habitation, and the products and services it provides (see Volume 12 of the Treatise). It is therefore no wonder that the development and application of ecosystem models in estuarine and coastal zone ecosystems have grown exponentially over the past four decades (Brush and Harris 2010). The first description of the mechanistic, numerical modelling of a marine ecosystem by Riley (1946) illustrated the value and power of the modelling approach to environmental research. Riley expanded the classical Lotka-Volterra population dynamic equations which describe the inter actions between predators and prey, i.e. dN1 dN2 = N1(r – gN2), and = N2 (fgN1 – d) (Lotka 1925, 1932; Volterra 1926) dt dt where n1 and n2 are the size of the prey and predator populations respectively, r the intrinsic rate of the prey, g the grazing or attack rate of the predators, f the efficiency with by which predators transfer consumed food into new offspring, and d is the death rate. Riley casted each rate process as a function of environmental parameters such as irradiance, temperature, and nutrient concentration, and in this way laid the basis for the mechanistic modelling of marine ecosystem processes (Brush and Harris 2010). Subsequent models by (Riley 1946) of phytoplankton and zooplankton (Riley 1947) were combined into a coupled nutrient-phytoplankton-zooplankton model in an analysis of the plankton dynamics in the western North Atlantic (Riley et al. 1949). These early initiatives of Riley and co-workers formed the basis of for the development of increasingly complex and detailed numerical ecosystem models of aquatic systems, ranging from models of plankton cycles to ecosystem models including biogeochemical cycling and the interactions of various biological components (e.g. Wetzel and Wiegert 1983, Hoffman 2000, Giblin and Vallino 2003). Publications such as “The Structure of Marine Systems” by Steele (1974), on the simulation of tidal flat estuaries by Baretta and Ruardij (1988), H.T. Odum’s modelling approach based on the principles o thermodynamics (Odum 1971), and the conceptualization of ecosystem maturity in the “Strategy of Ecosystem Development” by E.P Odum (1963), further enhanced the scientific interest in ecosystems modelling. The use of models expanded dramatically as mentioned above over the past four decades, which Brush and Harris (2010) attribute to (a) the general acceptance of modelling as a very important educational and research tool, and (b) the increasing capability and availability of personal computers and software development to run analytical and simulation models. Ecosystem and ecosystem process modelling have become an integrated part and extremely important tools for educational and research studies on the structure and function of ecosystems. These models have also become increasingly useful in management applications, particularly with respect to cultural eutrophication. An excellent and detailed review of the history and development of ecosystem modelling, its growth and application is given by Fath et al. (2011, Chapter 3, this volume). In Chapter 9.3 the importance of ecological modelling is addressed from a historical point of view to its present prominence as a problem solving tool for environmental management, and its role in our increasing ability to understand and manage natural resources on a global scale. In the context of climate change and its envisaged impact on the biodiversity of coastal marine ecosystems, the question of how a change in biodiversity will affect the functioning of ecosystems is currently receiving considerable attention by scientists and laymen alike. Ieno et al. (2006) and Naeem (2006) remarked that biodiversity-ecosystem function experiments need to adopt a holistic approach in order to distinguish between the contributions of multiple ecosystem processes to system function, while Rafaelli (2006) argued that a systems approach is necessary to address issues involving changes in biodiversity to changes in the natural functioning of coastal ecosystems. In Chapter 9.2 Raffaelli explore the biodiversity-ecosystem function relationships. He considered the Ythan River estuary as a suitable vehicle to assess the potential of the mass-balance approach for understanding the relationship between biodiversity and ecological functioning at a landscape scale. By presenting the biodiversity-ecological functioning question in terms of stocks and flows, as opposed to species richness and processes, Raffaelli highlighted the difficulty in making general statements about the effects of biodiversity change on system functioning. He furthermore illustrates that the mass-balance modelling approach can have the potential for exploring biodiversity-ecosystem processes-services relationships in a quite different way to the experimental approaches that have dominated this field to date, not only by employing perhaps a more appropriate metric of biodiversity but also by being able to accommodate the landscape scales at which environmental management policies are implemented and at which ecosystem services are delivered. Chapters 9.4, 9.6, 9.7, and 9.8 constitute the core or backbone of this volume on ecosystem modelling. In these chapters the underlying philosophy, mathematical formulations, and application of the four major analytical methodologies of ecosystems currently in use are presented. Firstly, Ulanowicz (Chapter 9.4, this volume) presents a detailed and excellent overview of the mathematical theory of network analysis (or “Ecological Network Analysis”, ENA), the development of quantitative methods to assess ecosystem structure and function, and the formulation of whole system attributes and properties to evaluate the maturity and internal organization of ecosystems. All of the algorithms used in network analysis were put together into a software package called NETWRK (Ulanowicz, 1987). The modelling approach of network analysis is increasingly being used to evaluate food webs and to provide an ecosystem approach to resource management. The construction of quantitative food webs depicting standing stocks and flows between them, network analysis allows the derivation of system properties, which in turn are being used for comparative ecosystem ecology, and which can provide useful information for management purposes. This chapter is followed by Chapter 9.5 (Baird) which reviews the application of network analysis to 21 ecosystems and 14 inter- and sub tidal sub-ecosystems. Chapter 9.5 provides an overview of the application of ecological network analysis to a large number of coastal ecosystems by comparing them over spatial and temporal scales. These comparisons highlighted the heterogeneity of coastal ecosystems when system properties derived from ENA are compared over spatial scales. Comparison of system attributes of the same system over time shed light on the impact of changes in specified environmental parameters on ecosystem function. Some “what if” questions are asked in the ecosystem context and the output results of simulation modelling using AUTOMOD are presented. This chapter also refers to the simultaneous behavior of macro elements, such as carbon, nitrogen, and phosphorus, in ecosystem dynamics as derived from network analysis. Secondly, Heymans et al. (Chapter 9.6) describes in detail the development of food web modelling tool called Ecopath (a core mass balance model) from which temporal (Ecosim) and spatial (Ecospace) dynamic simulations of aquatic ecosystems can be made. Ecopath and its two subroutines were designed and used to particularly assess interactions and impacts of fishing on ecosystems. It is widely used and Heymans et al. (this volume, Chapter 9.5) illustrate the usefulness of this modelling approach by means of 75 examples of coastal ecosystems where Ecopath models were used to explore past and future impacts of fishing on the environment. Thirdly, in Chapter 9.7 Niquil et al. discuss the novel method of inverse modelling in order to construct quantitative food webs where the information on stocks and flows in the network is incomplete. Inverse modelling was derived from applications in the geophysical sciences, and the derivations for application of inverse modelling to ecosystem models are given in this chapter and illustrated with a number of relevant examples. Fourthly, Chapter 9.8 (Swaney et al.) addresses, amongst others, the crucial issue of material fluxes in the coastal zone and biogeochemical transformations in estuaries and coastal seas. In this context the Land Ocean Interactions in the Coastal Zone (LOICZ) project was established in 1993 as one of the eight core projects of the International Geosphere-Biosphere Programme (IGBP) with its main objective to provide scientific information on the question: “How will changes in land use, seal level and climate alter coastal ecosystems, and what are the wider consequences” (Lindeboom2005). Swaney et al. (this volume) provides a detailed overview of the development and application of the LOICZ biogeochemical modelling protocol, to construct simple mass-balance models of water, salt, and nutrients in the characterization of coastal systems, and to determine the magnitude of coastal zone ecosystem metabolism. Several budget examples of different levels of complexity are included in the chapter, as well as a in-depth discussion on the application and further direction of the LOICZ budgeting protocol. The ten chapters that follow (9.9 to 9.18) were designed and applied to address specific aspects of the modelling of processes and phenomena of coastal zone ecosystems. Kang et al. (Chapter 9.9, this volume) provide an interesting and novel approach to ecosystems modelling by means of artificial neural networks (ANNs). ANNs can be fruitfully used to discover relationships between environmental variables and biological phenomena, such as phytoplankton blooms, and thus provide insight into ecosystem function. Kang et al. (this volume) concluded that ANN models are superior to linear-based models in terms of accuracy and predictability. In Chapter 9-10 (this volume) George Arhonditsis and co-authors discuss the integration of Bayesian inference techniques with the mathematical modelling of ecosystem processes. They address the issue of model reliability in the context of biogeochemical modelling, and introduce the Bayesian calibration of process based models as a significant advancement that warrants consideration in aquatic ecosystem research. Arhonditsis et al. conclusively demonstrate that the benefits from Bayesian calibration are well suited for policy decisions in environmental management issues. Eldridge and Roelke (Chapter 9.11, this volume) refer to the common phenomena of hypoxia in eutrophic systems. They pointed out that environmental conditions leading to hypoxia are not universally the same, and as a consequence tools and models to study hypoxia cannot be universal either. Eldridge and Roelke then proceed to develop a complex but applicable mathematical model to assess the interplay between hypoxia, nutrient loading and river discharge. In Chapter 9-12 John Walsh and co-authors give a detailed and delightful over view of the development and occurrence of harmful (or toxic) algal blooms (HABs) on a global scale. They discuss in detail the toxic dinoflagellate species and their role in HABs, the impact of human habitation in the coastal zone on the occurrence of toxic organisms in coastal ecosystems, and illustrate it by means of appropriate case studies. Chris Buzzelli (Chapter 9-13) provides excellent and applicable simulation models of biogeochemical processes in relation to water residence time of small tidal estuaries and embayments. Through the models Buzzelli illustrates the role of benthic filter feeders in phytoplankton abundance, and that oysters, as filter feeders, can indeed reduce phytoplankton concentrations which leads to improved light transparency. He pointed out that simulation models allow temporal comparisons of the magnitude of input drivers, and the biogeochemical and biotic responses in estuarine habitats. Asmus and Asmus (Chapter 9-15) discuss in detail the coupling between the pelagic and benthic domains in terms of particulate and nutrient fluxes. They present quantitative information on these processes for different coastal ecosystems and for different habitats within the same coastal ecosystem. They discuss and outline the problems involved in the measurement and modelling of nutrient flux between sediment and the overlying water column, and the uptake of nutrients by sediment biota. One of the major elements in the recycling processes of coastal and estuarine systems is nitrogen. In Chapter 9-16, Bob Christian and co-authors discuss the cycling of nitrogen in detail. They reviewed the use of network analysis to assess nitrogen cycling models, and presented results from the analysis of 20 nitrogen networks in this chapter. Both ecological network analysis and Environ analysis have been applied by Christian et al who then introduce appropriately the use of social network analysis on N cycling networks. This approach may provide new insights to our understanding of elemental cycling. Jeff King discusses in Chapter 17 (this volume) the phenomenon of benthic flux (i.e. the rate of flow across the bed of a body of water per unit area) as a surface-water/ground water interacting process which plays an important role in hydrological cycle and in the cycling of chemical elements (including nutrients) in coastal zone ecosystems. Jeff King eloquently discuss how benthic flux is mediated by a suite of component mechanisms such as, for example, pressure gradients, tidal forces, gravity waves, turbulence, etc., and presents a review of selected benthic flux mechanisms. He provides and discusses appropriate analytical models to illustrate benthic flux and applies these to a number of ecosystems along the Atlantic seaboard of the U.S. In Chapter 17 (this volume) Ashish Metha discusses the stability and dynamics of fine bed sediments in shallow water ecosystems. The stability, or not, of fine sediment on the ecosystem floor can affect erosion of the bed and turbidity of the overlying water, which may impact on ecological and biological processes. Ashish Metha provides a detailed insight into the factors that control bed stability as well as appropriate modeling protocol to assess fine sediment bed stability. The last chapter (9.19) in this volume by Brian Williams discusses the links between ecology, modelling and management, and provides guidelines for (a) ecologists in management investigations of coastal ecosystems, (b) for modelers in management investigations, and (c) the responsibilities of managers in the management of coastal zone ecosystems. An issue that were mentioned or discussed in several chapters of this volume was the impact of watershed management and the quality of fresh water inputs on estuarine ecosystems. It is common knowledge that fresh and sea water mix within the estuary to create a variable salinity gradient along its length axis. During the ebb tide mixed waters drain from the system, while inflowing fresh water is diluted during flood tides. The salinity gradient is dependent on the magnitude of fresh water inflow; little fresh water inflow will result in a higher salinity regime throughout the system than in those estuaries with substantial rates of fresh water inflows. Plants and animals became adapted over time to the variable salinity environment, and currently a large number plant, vertebrate and invertebrate species occur in estuaries. Because of the uniqueness of the estuarine environment, their aesthetic appearance, and the high abundance and productivity of plants and animals, they are widely exploited for commercial and recreational purposes. Moreover, human activities in catchments impact on the ecological integrity of estuaries through point and non-point source pollution by industrial effluents, domestic waste, and agricultural activities. The construction of impoundments leads to water abstraction resulting in a disruption of the normal flow of fresh water into estuaries. These activities invariably lead a reduction in the ecosystem’s functioning, and subsequently in its productivity, health, provision of direct and indirect services, and aesthetic value. 9.1.2 REFERENCES Baretta, J., Ruardji, P., (Eds.), 1988. Tidal Flat Estuaries: Simulation and Analysis of the Ems Estuary. Springer-Verlag, Berlin, 353pp. Brush, M.J., Harris, L.A., 2010. Introduction to a special issue of Ecological Modelling: Advances in Modelling Estuarine and Coastal Ecosystems: Approaches, Validation, and Applications”. Ecological Modelling 221, 965-968. Giblin, A.E., Valilino, J.J. 2003. The role of models in addressing coastal eutrophication. In: Canham, C.D., Cole, J.J., Lauenroth, W.K. (Eds.), Models in Ecosystem Science. Princeton University Press, NJ, pp327-343. Hofmann, E.E. 2000. Modeling for estuarine sysnthesis. In: Hobbie, J.E. (Ed.), Estuarine Science: A synthetic approach to research and practice. Island press, Washington, DC, pp129-148. Ieno, E.N., Solan, M., Batty, P., and Pierce, G.J. 2006. How diversity affects ecosystem functioning: roles of infaunal species richness, identity and density in marine benthos. Marine Ecology Progress Series, 311: 263-271. Lindeboom, H., 2005. Preface. In: Crossland, C.J., Kremer, H.H., Lineboom, H.J., Marshall-Crossland, J.I., le Tissier, M.D.A. (Eds.), Coastal Fluxes in the Anthropocene. Springer, Berlin, pp v-viii. Lotka, A.J., 1925. Elements of Physical Biology. Williams and Wilkins, Baltimore, MD. Reprinted in 1956 as: Elements of mathematical Biology. Dover Publications, Mineola, N.Y., pp 465. Lotka, A.J., 1932. The growth of mixed populations: two species competing for a common food supply. Journal of the Washington Academy of Science 22, 461-469. Naeem, S. 2006. Expanding scales in biodiversity-based research: challenges and solutions for marine systems. Marine Ecology Progress Series, 311: 273-283. Odum, E.P., 1969. The strategy of ecosystem development. Science 164, 262-270. Odum, H.T., 1971. Environment, Power, and Society. John Wiley and Sons, New York