@article{CiaisPhilippe2022,
  title = {Definitions and Methods to Estimate Regional Land Carbon Fluxes for the Second Phase of the {{REgional Carbon Cycle Assessment}} and {{Processes Project}} ({{RECCAP-2}})},
  author = {Ciais, Philippe and Bastos, Ana and Chevallier, Frédéric and Lauerwald, Ronny and Poulter, Ben and Canadell, Josep G. and Hugelius, Gustaf and Jackson, Robert B. and Jain, Atul and Jones, Matthew and Kondo, Masayuki and Luijkx, Ingrid T. and Patra, Prabir K. and Peters, Wouter and Pongratz, Julia and Petrescu, Ana Maria Roxana and Piao, Shilong and Qiu, Chunjing and Von Randow, Celso and Regnier, Pierre and Saunois, Marielle and Scholes, Robert and Shvidenko, Anatoly and Tian, Hanqin and Yang, Hui and Wang, Xuhui and Zheng, Bo},
