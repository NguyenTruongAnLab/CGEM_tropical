@article{HoanhChuThai2014,
  title = {Irrigation Development in the {{Vietnamese Mekong Delta}}: {{Towards}} Polycentric Water Governance?},
  shorttitle = {Irrigation Development in the {{Vietnamese Mekong Delta}}},
