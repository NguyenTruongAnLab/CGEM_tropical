  shorttitle = {A {{Model-Based Approach}} for {{Improving Surface Water Quality Management}} in {{Aquaculture Using MIKE}} 11},
  author = {Thu Minh, Huynh Vuong and Tri, Van Pham Dang and Ut, Vu Ngoc and Avtar, Ram and Kumar, Pankaj and Dang, Trinh Trung Tri and Hoa, Au Van and Ty, Tran Van and Downes, Nigel K.},
  date = {2022-01-29},
  journaltitle = {Water},
