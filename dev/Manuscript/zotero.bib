@article{LuZhao2022,
  title = {Chlorophyll-a Concentration Inversion Based on the Modified Quasi-Analytical Algorithm and Sentinel-3 {{OLCI}} in Daihai Lake, China},
  author = {Lu, Zhao and Duan, Huajie and Wang, Daqing and Cao, Jianwu and Du, Guoli and Deng, Zhengdong and Wang, Guangyuan and Xu, Haoli and Zhao, Xiaoning and Shi, Yue},
