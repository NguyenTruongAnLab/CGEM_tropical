  author = {Cüce, Hüseyin and Kalıpcı, Erkan and Ustaoğlu, Fikret and Kaynar, İlknur and Baser, Volkan and Türkmen, Mustafa},
  date = {2022-12},
  journaltitle = {International Journal of Sediment Research},
  shortjournal = {Int. J. Sediment Res.},
  volume = {37},
  number = {6},
  pages = {754--765},
  issn = {10016279},
  doi = {10.1016/j.ijsrc.2022.06.004},
