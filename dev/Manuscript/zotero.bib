  author = {Fustec, J. and Lode, T. and Le Jacques, D. and Cormier, J. P.},
  date = {2001-10-22},
  journaltitle = {Freshwater Biology},
  shortjournal = {Freshwater Biol.},
  volume = {46},
  number = {10},
  pages = {1361--1371},
