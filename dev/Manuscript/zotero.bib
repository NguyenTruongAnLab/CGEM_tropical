  issn = {1859-0152},
  url = {https://vjol.info.vn/index.php/ncpt-hue/article/view/4227},
  urldate = {2024-12-23},
  abstract = {Hệ thống s\&ocirc;ng V\&agrave;m Cỏ chạy dọc theo chiều d\&agrave;i của tỉnh Long An. T\&ecirc;n gọi \&ldquo;V\&agrave;m Cỏ\&rdquo; vốn bắt nguồn từ tiếng Khmer \&ldquo;piăm vaїco\&rdquo; (v\&agrave;m đ\&aacute;nh/l\&ugrave;a b\&ograve;). Điều n\&agrave;y cho biết đ\&acirc;y ch\&iacute;nh l\&agrave; con đường m\&ograve;n trũng do l\&ugrave;a/vận chuyển tr\&acirc;u b\&ograve; thuở xưa từ miền Lục Ch\&acirc;n Lạp xuống Thủy Ch\&acirc;n Lạp, m\&agrave; cụ thể l\&agrave; khoảng vị tr\&iacute; thị x\&atilde; T\&acirc;n An (tỉnh Long An) ng\&agrave;y nay.Đặc điểm tự nhi\&ecirc;n nổi bật của hệ thống s\&ocirc;ng V\&agrave;m Cỏ l\&agrave; kh\&ocirc;ng c\&oacute; nguồn r\&otilde; r\&agrave;ng. Nguồn cung cấp nước chủ yếu l\&agrave; từ biển v\&agrave;o (\&ldquo;Ngược\&rdquo;), n\&ecirc;n c\&agrave;ng về \&ldquo;hạ lưu\&rdquo; th\&igrave; s\&ocirc;ng c\&agrave;ng uốn kh\&uacute;c mạnh, tạo th\&agrave;nh những đường cong li\&ecirc;n tiếp (\&ldquo;Bao\&rdquo;), đ\&oacute; ch\&iacute;nh l\&agrave; nguồn gốc của t\&ecirc;n gọi (v\&agrave;m) Bao Ngược. Đồng thời do hội tụ nhiều d\&ograve;ng chảy n\&ecirc;n v\&agrave;m Bao Ngược c\&oacute; những xo\&aacute;y nước nguy hiểm, thường nhận ch\&igrave;m ghe thuyền.Do bị thủy triều chi phối mạnh n\&ecirc;n hệ thống s\&ocirc;ng V\&agrave;m Cỏ bị nhiễm mặn nặng. Tuy nhi\&ecirc;n, từ những năm 80 của thế kỷ trước, nhờ hệ thống kinh đ\&agrave;o m\&agrave; hệ thống s\&ocirc;ng V\&agrave;m Cỏ nhận được lượng nước ngọt đ\&aacute;ng kể từ s\&ocirc;ng Tiền, khiến \&aacute;p lực d\&ograve;ng chảy tăng v\&agrave; độ nhiễm mặn giảm hẳn.ABSTRACTThe currents of V\&agrave;m Cỏ river cover the whole length of Long An province.The name \&ldquo;V\&agrave;m Cỏ\&rdquo; originates from the Khmer word \&ldquo;piăm vaїco\&rdquo; (trail for herding cattle).This fact points out that this is the sunken trail left by the flocking of cattle from Lục Ch\&acirc;n Lạp to Thủy Ch\&acirc;n Lạp in the ancient time. To be more specific, today it is located roughly at T\&acirc;n An commune (Long An province).It is because of this that V\&agrave;m Cỏ river does not have a specific source. The main source of water for this river is from the sea (\&ldquo;Ngược\&rdquo; [against the current]). Consquently, nearer to its lower part, the river bends continually, making various curves(\&ldquo;bao\&rdquo;[curving\&rsquo;\&rsquo;]). These facts help explain the name of the river \&rdquo;Bao Ngược\&rdquo;. Also the V\&agrave;m Cỏ river is made up by numerous water currents that give rise to various dangerous whirlpools in the river, which sinks many boats and ships.Strongly affected by tides from the sea, this river is heavily salinized. Nevertheless, since the 1980\&rsquo;s, thanks to the construction of articficial networks of canals, the river\&rsquo;s currents get a great amount of fresh water from the Tiền river, which helps highten the speed of its current as well as remarkably cut down its salinity.},
  issue = {2(73)},
  langid = {vietnamese},
  keywords = {Salinity},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Books\Research\Lý - 2009 - Tìm hiểu về hệ thống sông Vàm CỏStudying the Currents of Vàm Cỏ River.pdf}
}

@article{LynchJanetK.2010,
  title = {Controls of Riverine {{CO}} {\textsubscript{2}} over an Annual Cycle Determined Using Direct, High Temporal Resolution {\mkbibemph{p}} {{CO}} {\textsubscript{2}} Measurements},
  author = {Lynch, Janet K. and Beatty, Cory M. and Seidel, Matthew P. and Jungst, Laura J. and DeGrandpre, Michael D.},
  date = {2010-09},
  journaltitle = {Journal of Geophysical Research: Biogeosciences},
  shortjournal = {J. Geophys. Res.: Biogeosci.},
  volume = {115},
  number = {G3},
  pages = {2009JG001132},
  issn = {0148-0227},
  doi = {10.1029/2009JG001132},
  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1029/2009JG001132},
  abstract = {Autonomous CO               2               sensors were deployed in the Clark Fork River, Montana, USA, to characterize the partial pressure of CO               2               (               p               CO               2               ) during an annual cycle. A total of 23,941 measurements were made spanning the period 2002–2006. These data were compiled into a composite data set covering ∼309 days, giving an unprecedented yearlong view of the carbon cycle dynamics of a riverine system. Seasonal               p               CO               2               varied from a winter minimum of ∼100               μ               atm to a fall maximum of ∼900               μ               atm. The               p               CO               2               changed by as much as 460               μ               atm during a diel period, much larger than the range of the seasonal mean, in contrast to most other aquatic ecosystems where seasonal variability dominates. The diel               p               CO               2               amplitude was primarily controlled by the net ecosystem production (NEP) throughout the year, although heating/cooling and air‐water exchange significantly altered the diel               p               CO               2               (and pH) magnitude. Although infrequent, rain events contributed ∼21\% to the cumulative short‐term changes in inorganic carbon through CO               2               ‐enriched runoff. The seasonal cycle was controlled by temperature, NEP, and discharge. The Clark Fork River maintained               p               CO               2               levels that were supersaturated with respect to the atmosphere for the majority of the year. River‐to‐atmosphere CO               2               gas exchange was estimated to be between 4.7 and 7.1 mol C m               −2               yr               −1               . The loss of CO               2               to the atmosphere arises from net heterotrophy that averaged 13.8 mmol m               −2               d               −1               . The time series also captured important episodic events including macrophyte sloughing that led to a pulse of respiration that represented 7\% of the annual CO               2               gas efflux and cloudy periods that occurred every 7–18 days that dramatically decreased the               p               CO               2               through cooling.},
  langid = {english},
  keywords = {CO2,Discharge},
  annotation = {37 citations (Crossref/DOI) [2024-02-18]\\
rate: 2},
  file = {H:\My Drive\References\Mendeley\PDF\Lynch et al. - 2010 - Controls of riverine CO2 over an annual cycle determined using direct, high temporal resolution pCO2.pdf}
}

