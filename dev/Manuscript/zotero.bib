  doi = {10.1080/02626667.2025.2530125},
  url = {https://doi.org/10.1080/02626667.2025.2530125},
  urldate = {2026-01-16},
  abstract = {Dissolved silica (DSi) can play a significant role in primary production in coastal and marine ecosystems. This paper describes the silica module developed for the hydrology and water quality catchment model HYPE, and its application in Sweden. The model simulates weathering of silicate-containing minerals and processes in the surface water system where DSi may be used in the production of biogenic silica. The model was able to reasonably simulate levels of DSi across Sweden (mean relative error~=~26.9\%) while also capturing some of the temporal dynamics (mean Pearson correlation coefficient~=~0.44). The calibrated model was used to quantify DSi fluxes across Sweden as well as to perform an assessment using the Indicator of Coastal Eutrophication Potential (ICEP). ICEP values calculated for 25 large Swedish rivers were all negative, albeit with a large spatial variability, indicating that Swedish rivers contribute to a favourable nutrient ratio in Swedish coastal waters.},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Modelling\Long-term\Strömqvist et al. - 2025 - Large-scale semi-distributed modelling of dissolved silica fluxes and assessment of their role in co.pdf}
}

