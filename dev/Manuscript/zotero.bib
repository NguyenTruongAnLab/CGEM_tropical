@article{KhuyenVo2022,
  title = {Assessing {{Microplastic Prevalence}} and {{Dispersion}} from {{Saigon Urban Canals}} via {{Can Gio Mangrove Reserve}} to {{East Sea}} by {{Raman Scattering Microscopy}}},
  author = {Khuyen, Vo and Le, Dinh and Le, Hung and Fischer, Axel and Dornack, Christina},
