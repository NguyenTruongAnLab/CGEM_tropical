  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Satellites\Water-quality\Huang et al. - 2017 - Spatiotemporal variation in particulate organic carbon based on long-term MODIS observations in taih.pdf}
}

@article{HuangChao2020,
  title = {Carbon and Nitrogen Isotopic Composition of Particulate Organic Matter in the {{Pearl River Estuary}} and the Adjacent Shelf},
  author = {Huang, Chao and Chen, Fajin and Zhang, Shuwen and Chen, Chunqing and Meng, Yafei and Zhu, Qingmei and Song, Zhiguang},
  date = {2020-11-05},
