@article{DeSilvaSenaS.2010,
  title = {Estimation of {{Nitrogen}} and {{Phosphorus}} in {{Effluent}} from the {{Striped Catfish Farming Sector}} in the {{Mekong Delta}}, {{Vietnam}}},
  author = {De Silva, Sena S. and Ingram, Brett A. and Nguyen, Phuong T. and Bui, Tam M. and Gooley, Geoff J. and Turchini, Giovanni M.},
  date = {2010-11},
  journaltitle = {AMBIO},
  shortjournal = {AMBIO},
  volume = {39},
