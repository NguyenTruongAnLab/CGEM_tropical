  pages = {115041},
  issn = {00139351},
  doi = {10.1016/j.envres.2022.115041},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0013935122023684},
  urldate = {2025-07-08},
  abstract = {Rice cultivation regions have a high density of open water networks to meet the requirements of rice growth and production. These open water networks have a significant risk of carbon (C) emissions due to agricultural production, but the C emissions from these waters are not clearly recorded in previous studies. Therefore, this study aimed to explore the pattern and internal mechanism of methane (CH4) and carbon dioxide (CO2) emissions from multiple types of waters (i.e., river, fish pond, reservoir, and ditch) in a typical rice cultivation region in southwestern China. The annual CH4 and CO2 fluxes were higher in the downstream river (2.79–94.89 and 39.39–1699.98 mg m 2 h 1) and ditch (8.80–74.99 and 123.43–542.65 mg m 2 h 1, respectively) and lower in the reservoir ( 0.67 to 3.45 and 239.15 to 141.50 mg m 2 h 1) (P {$<$} 0.05). The monthly trends of CH4 and CO2 fluxes from the middle river and ditch were driven by interactive reactions of rice cultivation practices and precipitation. In contrast, the emission patterns of CH4 and CO2 from the lower river, upper river, and fish pond were mainly driven by domestic sewage discharge, precipitation, and aquaculture practices, respectively. This study suggested that river and ditch were more sensitive to C emissions than other waters, and the rice production period was the critical period for controlling C emission. Although rice paddy soils yield more cumulative emissions of CH4, water networks in rice cultivation regions were possible hotspots for C emissions due to the higher emission intensities, which were largely overlooked before. Thus, it is necessary to refine and promote practices to better mitigate C emissions from waters in rice cultivation regions in the future.},
  langid = {english},
  file = {H:\My Drive\References\Mendeley\Zotero\storage\6NI8ZS4H\Deng et al. - 2023 - CH4 and CO2 emissions in water networks of rice cultivation regions.pdf}
}

@article{DengYawen2025,
  title = {Detecting the Onset of Rice Field Inundation in the {{Lower Mississippi River Basin}} via {{Harmonized Landsat Sentinel-2}} ({{HLS}}) Satellite Time Series},
  author = {Deng, Yawen and Peng, Bin and Guan, Kaiyu and Runkle, Benjamin R. K. and Moreno-García, Beatriz and Wu, Xiaocui and Wang, Sheng and Zhou, Qu and Reba, Michele L.},
  date = {2025-10-01},
  journaltitle = {ISPRS Journal of Photogrammetry and Remote Sensing},
  shortjournal = {ISPRS J. Photogramm. Remote Sens.},
  volume = {228},
  pages = {28--43},
  issn = {0924-2716},
  doi = {10.1016/j.isprsjprs.2025.07.003},
  url = {https://www.sciencedirect.com/science/article/pii/S0924271625002655},
  urldate = {2025-07-18},
  abstract = {Accurate spatiotemporal information on inundation dynamics in paddy rice fields at the field scale is essential for assessing the impacts of various rice water management strategies, quantifying greenhouse gas (GHG) emissions, and predicting rice yield. However, there is still a lack of field-level inundation data for paddy rice across large spatial domains. Here, we aim to develop an adaptive and scalable rule-based algorithm (PHASE – Phenology, Hydrology, and Spectral Evaluation) to accurately detect the onset date of paddy rice inundation at the field level using time-series Harmonized Landsat and Sentinel-2 (HLS) satellite data. This algorithm utilizes phenological metrics extracted from HLS Land Surface Water Index (LSWI) time series during the rice growth cycle to help identify inundation-induced temporal drops in the water-sensitive shortwave infrared band (SWIR2), thereby facilitating accurate prediction of the starting date of inundation (SDI). The predictions of inundation onset dates were validated against field measurements collected during 2018–2023 over rice fields with diverse water management strategies. Accuracy assessments showed that the method performed robustly and accurately in detecting inundation onset dates across 52 calibration site-years (2018–2022), achieving a Lin’s Concordance Correlation Coefficient (LCCC) of 0.92 and a Mean Absolute Error (MAE) of 4.51~days. It outperformed traditional water index threshold methods, which exhibited MAEs ranging from approximately 5 to 8~days. Further evaluation using independent field data from 2023 confirmed the enhanced performance of our approach, which combines both phenology and spectral information. The algorithm was scaled up across all rice-growing areas in the Lower Mississippi River Basin, which accounts for about 70\% of the total rice production in the United States. The average SDI ranged from day-of-year (DOY) 162 to 175 during 2018–2023, with earlier SDIs observed in the southern regions compared to northern regions. The spatial and temporal variability in SDI was primarily driven by temperatures in April and May, spring precipitation, and soil moisture conditions. The proposed method can be extended to other rice-planting regions to generate inundation calendars, thereby supporting more efficient and sustainable water management, as well as improving estimates of rice productivity and GHG emissions.},
  keywords = {Harmonized Landsat and Sentinel-2,Inundation dates,Phenology,Remote Sensing,Rice},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Satellites\CO2\Deng et al. - 2025 - Detecting the onset of rice field inundation in the Lower Mississippi River Basin via Harmonized Lan.pdf}
}

