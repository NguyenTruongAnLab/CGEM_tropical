@article{ForteEdoardo2023,
  title = {Characterization of Plastic Transport in the {{Saigon River}}: {{An}} Analysis of the River Stretch That Crosses {{Ho Chi Minh City}} Conducted in the Rainy Season.},
  shorttitle = {Characterization of Plastic Transport in the {{Saigon River}}},
  author = {Forte, Edoardo and Lena, Francesca and Zamuner, Agatha},
  date = {2023},
  url = {https://repository.tudelft.nl/islandora/object/uuid%3A26d848f8-35d0-47bf-9a3e-f2de017398cf},
  urldate = {2024-05-24},
  abstract = {The Saigon River, coursing through Ho Chi Minh City, is a vital yet alarmingly polluted waterway. It ranks among the top 50 rivers globally contributing to plastic pollution. This study delves into the complex mechanisms governing the transport of floating plastic within a tidal system, such as the Saigon River.\&lt;br/\&gt;Our methodology adopts a multifaceted approach, combining visual observations, on-site measurements, and a comparison with existing literature data and methodologies. The factors influencing plastic transport in the studied river stretch are several and complex, ranging from the seasonal fluctuations in rainfall and tidal patterns to the role played by water hyacinths, acting as effective catchments for plastic litter, thus shaping the trajectory of these materials. Furthermore, we investigate the different types of plastic that flow on the river surface.\&lt;br/\&gt;At the end of our research, we develop an early-stage conceptual model. This model serves as a framework that could help understanding plastic transport within the Saigon River and emphasizing the interplay of numerous influencing factors.\&lt;br/\&gt;Our findings underscore the necessity for comprehensive investigations into plastic transport in the Saigon River. By addressing these knowledge gaps, we can develop more effective strategies to mitigate plastic pollution.},
  langid = {english},
  file = {H\:\\My Drive\\References\\Mendeley\\PDF\\My Collection\\Quality index\\Saigon\\Forte et al. - 2023 - Characterization of plastic transport in the Saigon River An analysis of the river stretch that cro.pdf;H\:\\My Drive\\References\\Mendeley\\PDF\\My Collection\\Quality index\\Tidal effect\\Forte et al. - 2023 - Characterization of plastic transport in the Saigon River An analysis of the river stretch that cro.pdf}
