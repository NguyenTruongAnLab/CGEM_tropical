@article{PohleIna2021,
  title = {A Framework for Assessing Concentration‐discharge Catchment Behavior from Low‐frequency Water Quality Data},
  author = {Pohle, Ina and Baggaley, Nikki and Palarea‐Albaladejo, Javier and Stutter, Marc and Glendell, Miriam},
  date = {2021-09},
  journaltitle = {Water Resources Research},
  shortjournal = {Water Resour. Res.},
  volume = {57},
  number = {9},
  pages = {e2021WR029692},
  issn = {0043-1397, 1944-7973},
  doi = {10.1029/2021WR029692},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1029/2021WR029692},
  urldate = {2023-07-11},
  abstract = {Abstract                            Effective nutrient pollution mitigation measures require in‐depth understanding of spatio‐temporal controls on water quality which can be obtained by analyzing export regime and hysteresis patterns in concentration‐discharge (                              ) relationships. Such analyses require high‐frequency data (hourly or higher resolution), hampering the assessment of hysteresis patterns in widely available low‐frequency (monthly, biweekly) regulatory water quality data. We propose a reproducible classification of                              relationships considering export regime (dilution, constancy, enrichment) and long‐term average hysteresis pattern (clockwise, no hysteresis, anticlockwise) applicable to low‐frequency water quality data. The classification is based on power‐law                              models with separate parametrization for low and high discharge and rising and falling hydrograph limb, enabling a better representation of                              dynamics. The classification has been applied to a 30‐years record of daily streamflow and monthly spot samples of solute concentrations in 45 Scottish catchments with contrasting characteristics in terms of topography, climate, soil and land cover. We found that                              classification is solute‐ and catchment‐specific and linked to upland versus lowland catchments and streamflow variability. However as the relationship between solute behavior and catchment characteristics is variable, we propose that future typologies should integrate both water quality response, that is,                              classification, and catchment characteristics. The data‐driven                              classification allows us to increase the information content of low‐frequency water quality data and thus inform mitigation measures, monitoring strategies, and modeling approaches. Such approaches open up an ability to characterize processes and best management for a wider number of catchments, subject to regulatory surveillance and outside of research catchments.                        ,              Key Points                                                                A reproducible classification of concentration‐discharge relationships was developed                                                     Export regime and hysteresis pattern of low‐frequency water quality data are considered                                                     Catchment concentration‐discharge classification varies spatially and among solutes},
  langid = {english},
  annotation = {19 citations (Crossref/DOI) [2024-02-18]},
  file = {H:\My Drive\References\Mendeley\PDF\Pohle et al. - 2021 - A Framework for Assessing Concentration-Discharge Catchment Behavior From Low-Frequency Water Qualit.pdf}
}

