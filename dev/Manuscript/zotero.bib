  author = {Kupfer, Nick and Vo, Tuan Quoc and Bachofer, Felix and Huth, Juliane and Vereecken, Harry and Weihermüller, Lutz and Montzka, Carsten},
  date = {2024-01},
  journaltitle = {Remote Sensing},
  shortjournal = {Remote Sens.},
  volume = {16},
  number = {19},
  pages = {3569},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2072-4292},
  doi = {10.3390/rs16193569},
  url = {https://www.mdpi.com/2072-4292/16/19/3569},
  urldate = {2025-07-08},
  abstract = {In response to economic and environmental challenges like sea-level rise, salinity intrusion, groundwater extraction, sand mining, and sinking delta phenomena, the demand for solutions to adapt to changing conditions in riverine environments has increased significantly. High-quality analyses of land use and land cover (LULC) dynamics play a critical role in addressing these challenges. This study introduces a novel high-spatial resolution satellite-based approach to identify sub-seasonal LULC dynamics in the Mekong River Delta (MRD), employing a three-year (2021–2023) Sentinel-1 and Sentinel-2 satellite data time series. The primary obstacle is discerning detailed vegetation dynamics, particularly the seasonality of rice crops, answered through quantile mapping, harmonic regression with Fourier transform, and phenological metrics as inputs to a random forest machine learning classifier. Due to the substantial data volume, Google’s cloud computing platform Earth Engine was utilized for the analysis. Furthermore, the study evaluated the relative significance of various input features. The overall accuracy of the classification is 82.6\% with a kappa statistic of 0.81, determined using comprehensive reference data collected in Vietnam. While the purely pixel-based approach has limitations, it proves to be a viable method for high-spatial resolution satellite image time series classification of the MRD.},
  issue = {19},
  langid = {english},
  keywords = {Fourier transform,Google Earth Engine,land use dynamics,Landuse,Mekong River Delta,quantile mapping,rice seasonalities,Seasonal,Sentinel-1,Sentinel-2,time series},
  annotation = {rate: 5},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Satellites\Landuse\Kupfer et al. - 2024 - Enhanced Monitoring of Sub-Seasonal Land Use Dynamics in Vietnam’s Mekong Delta through Quantile Map.pdf}
}

