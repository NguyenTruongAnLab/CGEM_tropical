@article{ZhangMingxi2021,
  title = {Spatial-Temporal Change of Land Use and Its Impact on Water Quality of East-Liao River Basin from 2000 to 2020},
  author = {Zhang, Mingxi and Rong, Guangzhi and Han, Aru and Riao, Dao and Liu, Xingpeng and Zhang, Jiquan and Tong, Zhijun},
