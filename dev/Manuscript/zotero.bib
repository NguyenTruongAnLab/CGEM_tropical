  urldate = {2023-09-21},
  abstract = {Arctic rivers are among the most pristine ecosystems worldwide but are under increasing threat from global and regional anthropogenic impacts, including long-range transport of pollutants, overfishing, exotic species, hydropower development, and climate change. Snow and ice are a particular feature of Arctic rivers and discharge is typically low or lacking during winter, but followed by high and dynamic flows in spring. Species richness generally decreases with increasing latitude, and isolated islands and archipelago are especially species poor compared to mainland regions, especially those with a continental climate. Salmonids are an important resource in Arctic rivers although under threat in many rivers. Hydrology, chemistry, biodiversity, and management issues are documented for three rivers in northern Norway (Altaelva, Tana, and Komagelva), six rivers in Russia (Varzuga, Onega, Northern Dvina, Mezen, Pecchora, and Kara), three rivers on Iceland (Geithellnaá, Laxá, and Vestari-Jökulsá), and one river on Svalbard (Bayelva).},
  isbn = {978-0-08-102612-0},
  keywords = {Algae,Biodiversity,Chemistry,Climate,Conservation,Hydrology,Impacts,Macroinvertebrates,Plankton,Salmonids},
  file = {H\:\\My Drive\\References\\Mendeley\\PDF\\Brittain et al. - 2022 - Chapter 13 - Arctic rivers.pdf;H\:\\My Drive\\References\\Mendeley\\Zotero\\storage\\SCX4W4EM\\B9780081026120000134.html}
}

