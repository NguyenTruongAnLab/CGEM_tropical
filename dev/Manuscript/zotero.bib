  author = {Freitas, Vânia and Almeida, C. Marisa R. and Rodrigues, Sabrina M. and Pereira, Rúben and Gorito, Ana M. and Cunha, Jacinto and Silva, Diogo M. and family=Heerden, given=Alexandre, prefix=van, useprefix=true and Ramos, Sandra},
