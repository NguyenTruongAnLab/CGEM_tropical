@article{ThiThuHuongTran2023,
  title = {Assessing Water Quality in the {{Dong Nai River}} ({{Vietnam}}): Implications for Sustainable Management and Pollution Control},
  shorttitle = {Assessing Water Quality in the {{Dong Nai River}} ({{Vietnam}})},
  author = {Thi Thu Huong, Tran and Quan, Tran Anh and Hanh, Nguyen Thi Hong and Tong, Nguyen Xuan},
  date = {2023-06-01},
  journaltitle = {Water Science \& Technology},
  shortjournal = {Water Sci. Technol.},
  volume = {87},
  number = {11},
  pages = {2917--2929},
  issn = {0273-1223, 1996-9732},
  doi = {10.2166/wst.2023.151},
  url = {https://iwaponline.com/wst/article/87/11/2917/95102/Assessing-water-quality-in-the-Dong-Nai-River},
  urldate = {2024-12-15},
  abstract = {The Dong Nai River provides essential water resources for millions of people across 11 provinces and cities in Vietnam. However, pollution from different sources such as household, farming, and industrial operations has caused the river’s water quality to deteriorate over the past decade. To gain a comprehensive understanding of the river’s surface water quality, this study employed the water quality index (WQI) across 12 different sampling sites. Results revealed a range of surface water quality, from poor to good according to the VN-WQI, and a medium level to even a bad level in some months according to the NS-WQI. The study also identified temperature, coliform, and dissolved oxygen (DO) as strong contributors to WQI values (according to the VN-WQI standard). Principal component analysis/factor analysis (PCA/FA) was used to determine pollution sources, with the results highlighting agricultural and domestic activities as the main contributors to river pollution. In conclusion, this study underscores the importance of effective planning and management of infrastructure zoning and local activities to improve the river’s surface water quality and surrounding areas, as well as safeguard the well-being of the millions who depend on it.},
  langid = {english},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Quality index\Delta\Thi Thu Huong et al. - 2023 - Assessing water quality in the Dong Nai River (Vietnam) implications for sustainable management and.pdf}
}

