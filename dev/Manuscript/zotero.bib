@article{LeThiPhuongQuynh2018,
  title = {{{CO}}{\textsubscript{2}} Partial Pressure and {{CO}}{\textsubscript{2}} Emission along the Lower {{Red River}} ({{Vietnam}})},
  author = {Le, Thi Phuong Quynh and Marchand, Cyril and Ho, Cuong Tu and Le, Nhu Da and Duong, Thi Thuy and Lu, XiXi and Doan, Phuong Kieu and Nguyen, Trung Kien and Nguyen, Thi Mai Huong and Vu, Duy An},
  date = {2018-08-15},
  journaltitle = {Biogeosciences},
  volume = {15},
  number = {15},
  pages = {4799--4814},
  publisher = {Copernicus GmbH},
  issn = {1726-4170},
  doi = {10.5194/bg-15-4799-2018},
  url = {https://bg.copernicus.org/articles/15/4799/2018/},
  urldate = {2024-09-11},
  abstract = {The Red River (Vietnam) is representative of a south-east Asian river system, strongly affected by climate and human activities. This study aims to quantify the spatial and seasonal variability of CO2 partial pressure and CO2 emissions of the lower Red River system. Water quality monitoring and riverine pCO2 measurements were carried out for 24\&thinsp;h at five stations distributed along the lower Red River system during the dry and the wet seasons. The riverine pCO2 was supersaturated relative to the atmospheric equilibrium (400\&thinsp;ppm), averaging about 1589±43\&thinsp;ppm and resulting in a water–air CO2 flux of 530.3±16.9\&thinsp;mmol\&thinsp;m−2\&thinsp;d−1 for the lower Red River. pCO2 and CO2 outgassing rates were characterized by significant spatial variation along this system, with the highest values measured at Hoa Binh station, located downstream of the Hoa Binh Dam, on the Da River. Seasonal pCO2 and CO2 outgassing rate variations were also observed, with higher values measured during the wet season at almost all sites. The higher river discharges, enhanced external inputs of organic matter from watersheds and direct inputs of CO2 from soils or wetland were responsible for higher pCO2 and CO2 outgassing rates. The difference in pCO2 between the daytime and the night-time was not significant, suggesting weak photosynthesis processes in the water column of the Red River due to its high sediment load.},
  langid = {english},
  keywords = {CO2,Delta,Vietnam},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\CO2\Delta\Le et al. - 2018 - CO2 partial pressure and CO2 emission along the lower Red River (Vietnam).pdf}
}

