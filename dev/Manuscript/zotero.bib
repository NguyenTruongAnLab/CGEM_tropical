  author = {Joesoef, A. and Huang, W.-J. and Gao, Y. and Cai, W.-J.},
  date = {2015-10-26},
  journaltitle = {Biogeosciences},
  volume = {12},
  number = {20},
  pages = {6085--6101},
  publisher = {Copernicus GmbH},
  issn = {1726-4170},
  doi = {10.5194/bg-12-6085-2015},
  url = {https://bg.copernicus.org/articles/12/6085/2015/bg-12-6085-2015.html},
  urldate = {2024-10-09},
  abstract = {Distributions of surface water partial pressure of carbon dioxide (pCO2) were measured on nine cruises in the Delaware Estuary (USA). The Delaware River was highly supersaturated in pCO2 with respect to the atmosphere during all seasons, while the Delaware Bay was undersaturated in pCO2 during spring and late summer and moderately supersaturated during mid-summer, fall, and winter. While the smaller upper tidal river was a strong CO2 source (27.1 ± 6.4 mol-C m−2 yr\&minus;1), the much larger bay was a weak source (1.2 ± 1.4 mol-C m−2 yr\&minus;1), the latter of which had a much greater area than the former. In turn, the Delaware Estuary acted as a relatively weak CO2 source (2.4 ± 4.8 mol-C m−2 yr\&minus;1), which is in great contrast to many other estuarine systems. Seasonally, pCO2 changes were greatest at low salinities (0 \&le; S pCO2 values in the summer nearly 3-fold greater than those observed in the spring and fall. Undersaturated pCO2 was observed over the widest salinity range (7.5 \&le; S pCO2 was generally observed in mid- to high-salinity waters (20 \&le; S 2 were observed throughout both the upper tidal river and lower bay. Positive correlations between river-borne and air–water CO2 fluxes in the upper estuary emphasize the significance of river-borne CO2 degassing to overall CO2 fluxes. While river-borne CO2 degassing heavily influenced CO2 dynamics in the upper tidal river, these forces were largely compensated for by internal biological processes within the extensive bay system of the lower estuary.},
  langid = {american},
  keywords = {CO2,Delta,Salinity,Thermal},
  annotation = {rate: 3},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\CO2\Delta\Joesoef et al. - 2015 - Air–water fluxes and sources of carbon dioxide in the Delaware Estuary spatial and seasonal variabi.pdf}
}

