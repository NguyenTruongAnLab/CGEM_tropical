@inproceedings{LeT.T.Huyen2012,
  title = {An {{Ecohydrological}}, {{Ecohydraulic Model System For Water Management Of The Saigon River System Under Tide Effect}}},
  booktitle = {Conference {{ISE}}},
  author = {Le, T. T. Huyen and Prilop, Karen and Quang, Dung and Lam, Günter and {Meon}},
  date = {2012-01-01},
  volume = {Conference},
  publisher = {Conference},
  abstract = {The 280 km long Saigon river including the upstream Dau Tieng reservoir is the most important drinking water supply source for the largest city in Vietnam (Ho Chi Minh City, HCMC) and other provinces. It also provides water for extensive irrigation systems. Located in the monsoon area, about 85\% percent of total water discharge of the river takes place in the rainy season from May to November. Droughts and low flows occur frequently during the dry season. The Saigon river is a complex semi diurnal tidal river which is affected by the water releases from the Dau Tieng reservoir, the tributaries, the irrigation drainage flows and the tidal currents. The river has been increasingly polluted since many years because of the rapid economic growth of HCMC and the surrounding provinces. Its catchment is characterized by high agricultural activities and numerous industrial companies which discharge untreated wastewater into the river. High concentrations of manganese and iron as well as salinity intrusion were noted since the last ten years. Within a research project financed by the German Ministry of Education and Research (BMBF) and the Vietnamese Ministry of Science (MOST), a coupled ecohydrological, ecohydraulic model system has been developed. In this paper, intermediate results of the ongoing project are presented. The system consists of models for the water balance, nutrient transport (SWAT), hydrodynamics and water quality (CE-QUAL-W2). The final version of the model system will also include an evaluation module. The model system can be used as an integrated numerical Water Pollution Control Management system (WPCM system) for the upper Saigon river system including the Dau Tieng reservoir. Based on monitoring data and collected data, the water quality status of the Dau Tieng reservoir and Saigon river were assessed by means of several methods. Simulation results of the coupled model system are discharges, water levels, nutrient loads, instream water quality, salinity etc. Difficulties and uncertainties associated with the model applications and missing data are discussed. The water balance, hydrodynamics and water quality were difficult to calibrate because of influences of uncontrolled human activities, strong tide effects and missing data. There are, for example, practically no data about the inflow into the reservoir, the actual water abstractions for irrigation and the return flows of irrigation water into the Saigon river. The water quality was measured irregularly and only in the low water time. Despite of these problems, reasonable results for the calibration of the model chain have been obtained.},
  eventtitle = {Conference {{ISE}} 2012},
  keywords = {Modelling,Nutrients,Salinity,Vietnam},
  annotation = {rate: 2},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Modelling\Carbon Modelling\Le et al. - 2012 - An Ecohydrological, Ecohydraulic Model System For Water Management Of The Saigon River System Under.pdf}
}

