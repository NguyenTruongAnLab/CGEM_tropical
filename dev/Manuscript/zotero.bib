  url = {https://www.sciencedirect.com/science/article/pii/S0165993616301868},
  urldate = {2025-05-06},
  abstract = {The oceanic uptake of anthropogenic CO2 causes pronounced changes to the marine carbonate system. High quality pCO2 measurements with good temporal and spatial coverage are required to monitor the oceanic uptake, identify regions with pronounced carbonate system changes, and observe the effectiveness of CO2 emission mitigation strategies. There are currently several instruments available, but many are unsuitable for autonomous deployments on in situ platforms such as gliders, moorings and Argo floats. We assess currently available technology on its suitability for in situ deployment, with a focus on optode technology developments. Optodes for pCO2 measurements provide a promising new technological approach, and were successfully calibrated over the range of 280–480~μatm applying modified time-domain dual lifetime referencing. A laboratory precision of 0.8~μatm (n~=~10) and a response time (τ90) of 165~s were achieved, and with further development pCO2 optodes may become as widely used as their oxygen counterparts.},
  langid = {english},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\CH4\Methods\Clarke et al. - 2017 - Developments in marine pCO2 measurement technology; towards sustained in situ observat.pdf}
}

