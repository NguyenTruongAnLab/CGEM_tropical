@online{LiJie2025,
  title = {Assessing the Impact of Land Use and Landscape Patterns on Water Quality in Yilong Lake Basin (1993–2023)},
  author = {Li, Jie and Wang, Ronggui and Jiang, Yuhan and Huang, Yue},
  date = {2025-08-12},
  eprinttype = {In Review},
  doi = {10.21203/rs.3.rs-7119035/v1},
  url = {https://www.researchsquare.com/article/rs-7119035/v1},
  urldate = {2025-09-25},
  abstract = {To investigate the in uence of land use landscape pattern on lake water quality in the basin, the land use and water quality data of Yilong Lake Basin from 1993 to 2023 were analyzed with GIS, RS and landscape ecology methods in this research. The results showed that: 1) the land use landscape pattern and water quality of Yilong Lake Basin had signi cant changes: the water surface of Yilong Lake decreased, the area of farmland and shrubs decreased, the area of grassland decreased dramatically, which were the main sources of growth of other land types, the area of trees increased signi cantly, and the area of building land increased by ve times. The landscape pattern analysis showed that the aggregation degree of core habitat in the basin increased and the landscape had decreased patch density and increased heterogeneity. In terms of water quality, the concentrations of TN, TP, NH4+-N, IMn and BOD5 decreased, the concentration of DO increased, and the concentration of Chl-a uctuated for a long time but did not decrease dramatically at the end of the period compared with the beginning. In general, the eutrophication degree of Yilong Lake slightly reduced. 2) There was a signi cant correlation between landscape pattern indexes and water quality indexes: ED, LSI, LPI and PD were negatively correlated with eutrophication of Yilong Lake, CONTAG was positively correlated, SHDI was strongly positively correlated with TN and IMn, and COHESION had a low interpretation rate for water quality changes. Among them, LPI and COHESION were signi cantly positively correlated with the concentration of DO, PD was signi cantly positively correlated with IMn, and SHDI was signi cantly negatively correlated with the concentration of DO, indicating that the "sink" landscape in the basin gradually dominated and the restoration of key ecological patches and the enhancement of landscape cohesion helped to improve water quality, while the increase of patch density and landscape heterogeneity possibly had negative in uence on water quality. 3) In the past 30 years, the ecological management and protection work of Yilong Lake, such as returning farmland to forests and lake, and wetland and sewage pipe network construction, achieved remarkable results which were re ected in the change of the relationship between land use landscape pattern and water quality in the basin. However, human activities still affected the dynamic evolution of water quality: the expansion of building land increased patch density, the reduction of shrubs and grassland weakened natural ltration, and the rapid urbanization process introduced more pollution sources. Although the increase of trees helped to improve water quality, the effect was not fully developed.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {⭐⭐⭐⭐},
  file = {H:\My Drive\References\Mendeley\PDF\My Collection\Quality index\Long-term\New\Li et al. - 2025 - Assessing the impact of land use and landscape patterns on water quality in yilong lake basin (1993–.pdf}
}

