  title = {Spatial Dependence of Gas Transfer Velocity in Boreal Reservoirs},
  author = {Bodmer, Pascal and Barbosa, Pedro and Bilodeau, François and Nadeau, Daniel F. and Parkes, Alice H. and Rust, Felipe and Thiboult, Antoine and Tremblay, Alain and Del Giorgio, Paul A.},
